// Publicación en Cloudflare (Worker con archivos estáticos).
// "name" + subdominio de la cuenta (legalhubbolivia) = www.legalhubbolivia.workers.dev
{
  "name": "www",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./salida",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
